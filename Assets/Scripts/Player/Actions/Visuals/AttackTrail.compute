// AttackTrail.compute

#pragma kernel CSMain

#include "UnityCG.cginc"

struct AttackParticle
{
    float3 posWS;
    float2 velXZ;
    float  u0;
    float  life;
    float  maxLife;
    float  size;
    uint   state;
};

RWStructuredBuffer<AttackParticle> _Particles;

float _Dt;
int   _ParticleCount;
int   _EmitCount;
int _StageActive;

float3 _AttackOriginWS;
float3 _AttackDirWS;

float  _TrailLength;
float  _BaseWidth;
float  _TipWidth;

float  _ForwardSpeed;
float  _TrailDrag;

float  _MinLife;
float  _MaxLife;
float  _SizeStart;
float  _SizeEnd;

float  _StageT;   // 0..1
float _StageDuration; // seconds

// --- basic RNG helpers ---

uint Hash(uint x)
{
    x += (x << 10);
    x ^= (x >>  6);
    x += (x <<  3);
    x ^= (x >> 11);
    x += (x << 15);
    return x;
}

float Random01(uint seed, uint salt)
{
    return frac(Hash(seed ^ salt) / 65535.0);
}

float2 RandomCircle(uint seed, uint salt)
{
    float ang = Random01(seed, salt) * 6.2831853; // 2π
    return float2(cos(ang), sin(ang));
}

[numthreads(64, 1, 1)]
void CSMain(uint id : SV_DispatchThreadID)
{

    
    if (id >= (uint)_ParticleCount) return;

    AttackParticle p = _Particles[id];

    // advance life
    p.life += _Dt;
    bool dead = (p.life >= p.maxLife) || (p.state == 0u);

    

    // If the current stage hasn't really started extending yet, don't spawn.
    if (_StageT < 0.02f)  // tweak threshold as needed
    {
        if (dead)
        {
            // keep particle dormant
            p.size  = 0.0;
            p.state = 0u;
        }
        _Particles[id] = p;
        return;
    }

    // respawn logic: first _EmitCount dead particles this frame
    if (dead && (id < (uint)_EmitCount))
    {
        uint seed = id * 9781u + 143u;
        

        // position along trail [0..StageT]; if StageT==0, keep them near origin
        float uMax = saturate(_StageT);
        float u0;

        float tipWindow = 0.2;                  // last 20% of current reach
        float uMin = max(0.0, uMax - tipWindow);

        // Bias toward tip
        float t  = pow(Random01(seed, 13u), 2.0);
        u0 = lerp(uMin, uMax, t);

        // width scale now safe
        float widthScale = saturate(_StageT * 3.0);

        // all motion on XZ plane
        float3 fwd = _AttackDirWS;
        fwd.y = 0.0;
        if (dot(fwd,fwd) < 1e-6) fwd = float3(1,0,0);
        fwd = normalize(fwd);

        // 2D perpendicular in XZ
        float2 fwd2   = normalize(float2(fwd.x, fwd.z));
        float2 right2 = float2(-fwd2.y, fwd2.x); // perp
        float3 right  = float3(right2.x, 0, right2.y);

        // width & side offset
        float width = lerp(_BaseWidth, _TipWidth, u0) * widthScale;

        // Strong bias toward center: pow(rand, k) with k > 1
        float r   = Random01(seed, 47u);
        float radial = sqrt(r);   // mild center bias

        // Centered around 0, not strictly ±width extremes
        float side = (Random01(seed, 31u) - 0.5) * 2.0 * width * radial;
        // -width..width but most values near 0

        float3 basePos = _AttackOriginWS + fwd * (u0 * _TrailLength);
        float3 posWS   = basePos + right * side;


        // initial velocity: strictly forward along the thrust axis
        float2 velXZ = fwd2 * _ForwardSpeed;


        // lifetime
        float baseSpan = lerp(_MinLife, _MaxLife, Random01(seed, 59u));

        // don't let a particle live longer than the stage
        float span = min(baseSpan, _StageDuration);

        p.posWS   = posWS;
        p.velXZ   = velXZ;
        p.u0      = u0;
        p.life    = 0.0f;
        p.maxLife = span;
        p.size    = _SizeStart;
        p.state   = 1u;
    }
    else if (dead)
    {
        p.size  = 0.0;
        p.state = 0u;
    }
    else
    {
        // alive: integrate 2D motion in XZ
        float2 vel = p.velXZ;
        float drag = exp(-_TrailDrag * _Dt);
        vel *= drag;

        // --- NEW: gently align velocity toward current attack direction ---
        float2 fwd2 = float2(_AttackDirWS.x, _AttackDirWS.z);
        if (dot(fwd2, fwd2) > 1e-6)
        {
            fwd2 = normalize(fwd2);
            float  speed    = length(vel);
            float2 dir      = (speed > 1e-6) ? (vel / speed) : fwd2;
            float  alignStr = 5.0;                  // tweak: how quickly it reorients
            float2 blended  = normalize(lerp(dir, fwd2, alignStr * _Dt));
            vel = blended * speed;
        }

        float3 delta = float3(vel.x, 0, vel.y) * _Dt;
        p.posWS += delta;
        p.velXZ = vel;

        // size over life: shrink to zero
        float t = saturate(p.life / max(p.maxLife, 1e-4));
        p.size = lerp(_SizeStart, _SizeEnd, t);
    }


    _Particles[id] = p;
}
