#pragma kernel IntegrateCS

struct Segment { float3 a; float3 b; float mag; };

StructuredBuffer<float3> _Seeds;                  // MUST be bound on Metal (even if procedural)
AppendStructuredBuffer<Segment> _Segments;

// Integration params
int   _SeedCount;
int   _MaxSteps;
float _Step;
float _MinMag;

// Procedural seed mode
float _SeedInnerFill;
float _SeedOuterFill;
float _SeedRadialPower;
float _SeedJitter;
int   _RandomSeed;
float _UseProceduralSeeds; // 0 = use _Seeds, 1 = procedural seeds

// Time / motion
float _TimeNow;
float _SpinStrength;
float _SpinSpeed;
float _WarbleStrength;
float _WarbleSpeed;

// Visual-only extras
float _PathWarbleStrength;
float _PathWarbleSpeed;
float _PathWarbleFrequency;

float _Pseudo3DEnabled;
float _Pseudo3DAmplitude;
float _Pseudo3DSpeed;
float _Pseudo3DTwist;

// Warp blending
float _WarpAmount;
float _WarpAlongAmount;
float _WarpPerpAmount;
float _WarpStartQ;
float _WarpRampExp;

// Boundary approach (RESTORED)
float _ConformStartQ;   // e.g. 0.15
float _ConformExp;      // e.g. 1.2
float _ConformAmount;   // e.g. 0.5

float _BoundaryEaseStart;
float _BoundaryEasePower;

// World / dipole
float3 _Center;
float  _PlanetRadius;
float  _MagnetosphereRadius;
float3 _DipoleAxis;
float  _DipoleMoment;

// Wind / global envelope
float3 _WindDir;
float  _SolarWindStrength;
float  _GlobalWindStrength;

float  _DaysideCompression;
float  _NightsideStretch;
float  _TailFieldStrength;

float  _PressureGain;
float  _UseSquaredPressure;

float  _DaysideResponseExp;
float  _TailResponseExp;
float  _TailPerpResponseExp;

float  _MagnetopauseBlendWidth;
float  _DayPerpCompressionRatio;
float  _TailPerpFlareRatio;

float  _MinDaysideAlongScale;
float  _MinDaysidePerpScale;
float  _StormDaysideCompressionBoost;

float  _FlankPinchStrength;
float  _MinFlankPerpScale;
float  _FlankPinchWidth;
float  _FlankPinchResponseExp;

// Storm
float _StormIntensity;
float _StormWarpScale;
float _StormEnvelope;

float _StormFrontCenterS;
float _StormFrontThickness;
float _StormWakeLength;
float _StormFrontFeather;
float _StormFrontLocalWarpAmount;
float _StormGlobalWarpShare;

// ---------------- helpers ----------------
float Smooth01(float x) { x = saturate(x); return x*x*(3.0-2.0*x); }

float Smoothstep01(float edge0, float edge1, float x)
{
    if (edge1 <= edge0) return (x < edge0) ? 0.0 : 1.0;
    float t = saturate((x - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}

float3 NormalizeXZ(float3 v)
{
    v.y = 0.0;
    float m2 = dot(v, v);
    if (m2 < 1e-10) return float3(1,0,0);
    return v * rsqrt(m2);
}

uint HashU(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float Hash01(uint x)
{
    uint h = HashU(x);
    return (h & 0x00FFFFFFu) / 16777216.0;
}

float2 Rot2(float2 v, float a)
{
    float s = sin(a), c = cos(a);
    return float2(c*v.x - s*v.y, s*v.x + c*v.y);
}

// Dipole field (unwarped)
float3 DipoleField(float3 p)
{
    float3 r = p - _Center;
    r.y = 0.0;
    float r2 = dot(r, r);
    if (r2 < 1e-10) return 0;

    float rMag = sqrt(r2);
    float3 rHat = r / rMag;
    float3 m = NormalizeXZ(_DipoleAxis) * _DipoleMoment;

    float mDotR = dot(m, rHat);
    return (3.0 * mDotR * rHat - m) / (rMag * rMag * rMag);
}

// Storm mask
void StormMaskAt(float3 p, out float frontCore, out float wake)
{
    frontCore = 0.0;
    wake = 0.0;

    if (_StormEnvelope <= 1e-5) return;

    float3 w = NormalizeXZ(_WindDir);
    float3 r = p - _Center;
    r.y = 0.0;

    float along = dot(r, w);
    float dist = along - _StormFrontCenterS;

    float halfT = _StormFrontThickness * 0.5;
    float feather = lerp(0.05, 2.0, saturate(_StormFrontFeather));

    float ad = abs(dist);
    float core = 1.0 - Smoothstep01(halfT, halfT * feather, ad);

    float wk = 0.0;
    if (_StormWakeLength > 1e-4 && dist > 0.0)
    {
        float u = saturate(dist / _StormWakeLength);
        wk = 1.0 - Smooth01(u);
    }

    frontCore = core * _StormEnvelope;
    wake = wk * _StormEnvelope;
}

// Envelope model
void GetLocalEnvelope(float windStrength, float along, out float a, out float b, out float alongScale, out float perpScale)
{
    float R = max(0.001, _MagnetosphereRadius);

    float bw = (_MagnetopauseBlendWidth > 0.001) ? _MagnetopauseBlendWidth : (R * 0.35);
    float tTail = Smoothstep01(-bw, bw, along);

    float w = max(0.0, windStrength);
    float x = (_UseSquaredPressure > 0.5) ? (w*w) : w;

    float pressure01 = 1.0 - exp(-x * max(1e-4, _PressureGain));
    pressure01 = saturate(pressure01);
    pressure01 = max(pressure01, 1e-6);

    float pDay  = pow(pressure01, max(0.01, _DaysideResponseExp));
    float pTail = pow(pressure01, max(0.01, _TailResponseExp));
    float pPerp = pow(pressure01, max(0.01, _TailPerpResponseExp));

    float comp    = _DaysideCompression * pDay;
    float stretch = _NightsideStretch * pTail;
    float flare   = _TailFieldStrength * pPerp;

    float stormMaxDrive = max(1e-4, _StormIntensity * _StormWarpScale);
    float stormContribution = max(0.0, windStrength - _SolarWindStrength);
    float stormLevel01 = saturate(stormContribution / stormMaxDrive);
    comp *= (1.0 + _StormDaysideCompressionBoost * stormLevel01);

    float dayAlong = 1.0 / (1.0 + comp);
    float dayPerp  = 1.0 / (1.0 + comp * _DayPerpCompressionRatio);

    float tailAlong = 1.0 + stretch;
    float tailPerp  = 1.0 + flare * _TailPerpFlareRatio;

    dayAlong  = clamp(dayAlong, _MinDaysideAlongScale, 1.0);
    dayPerp   = clamp(dayPerp,  _MinDaysidePerpScale,  1.25);
    tailAlong = clamp(tailAlong, 1.0, 18.0);
    tailPerp  = clamp(tailPerp,  1.0, 6.0);

    alongScale = lerp(dayAlong, tailAlong, tTail);
    perpScale  = lerp(dayPerp,  tailPerp,  tTail);

    float fw = (_FlankPinchWidth > 0.001) ? _FlankPinchWidth : bw;
    fw = max(0.001, fw);

    float flankW = exp(-(along * along) / (fw * fw));
    float pFlank = pow(pressure01, max(0.01, _FlankPinchResponseExp));
    float pinch01 = saturate(_FlankPinchStrength * pFlank);

    float targetPerp = lerp(perpScale, max(0.001, perpScale * _MinFlankPerpScale), pinch01);
    perpScale = lerp(perpScale, targetPerp, flankW);

    a = R * alongScale;
    b = R * perpScale;
}

float EnvelopeQ(float3 p, float windStrength)
{
    float3 w = NormalizeXZ(_WindDir);
    float3 r = p - _Center; r.y = 0.0;

    float along = dot(r, w);
    float3 perp = r - along * w;

    float a, b, sa, sp;
    GetLocalEnvelope(windStrength, along, a, b, sa, sp);

    float q2 = (along*along)/(a*a) + dot(perp,perp)/(b*b);
    return sqrt(max(0.0, q2));
}

float3 EnvelopeNormalApprox(float3 p, float windStrength)
{
    float3 w = NormalizeXZ(_WindDir);
    float3 r = p - _Center; r.y = 0.0;

    float along = dot(r, w);
    float3 perp = r - along * w;

    float a, b, sa, sp;
    GetLocalEnvelope(windStrength, along, a, b, sa, sp);

    float3 n = w * (along / (a*a)) + perp * (1.0 / (b*b));
    return NormalizeXZ(n);
}

float3 ClampToEnvelopePreserveY(float3 p, float windStrength)
{
    float yKeep = p.y;

    float3 w = NormalizeXZ(_WindDir);
    float3 r = p - _Center; r.y = 0.0;

    float along = dot(r, w);
    float3 perp = r - along*w;
    float perpMag = sqrt(max(0.0, dot(perp,perp)));

    float a, b, sa, sp;
    GetLocalEnvelope(windStrength, along, a, b, sa, sp);

    float q = sqrt((along*along)/(a*a) + (perpMag*perpMag)/(b*b));
    if (q > 1.0)
    {
        float inv = 1.0 / q;
        p = _Center + w*(along*inv) + perp*inv;
    }

    p.y = yKeep;
    return p;
}

float3 WarpVisualNoClamp(float3 pBase, float windStrength)
{
    float q = EnvelopeQ(pBase, windStrength);
    float warpW = Smoothstep01(_WarpStartQ, 1.0, q);
    warpW = pow(max(1e-6, warpW), max(0.25, _WarpRampExp));
    warpW *= saturate(_WarpAmount);

    if (warpW <= 1e-6) return pBase;

    float3 w = NormalizeXZ(_WindDir);
    float3 r = pBase - _Center; r.y = 0.0;

    float along0 = dot(r, w);
    float3 perp0 = r - along0*w;

    float a0,b0,sa,sp;
    GetLocalEnvelope(windStrength, along0, a0,b0, sa,sp);

    float alongWarp = lerp(1.0, sa, saturate(_WarpAlongAmount));
    float perpWarp  = lerp(1.0, sp, saturate(_WarpPerpAmount));

    float3 pWarp = _Center + (w*(along0*alongWarp) + perp0*perpWarp);
    pWarp.y = _Center.y;

    float3 outP = lerp(pBase, pWarp, warpW);
    outP.y = _Center.y;
    return outP;
}

// Map a world-space point into the envelope-deformed "field space" (always applies sa/sp; NOT gated by _WarpAmount).
// This is used for direction conformity so arcs lean with the envelope *even if* you keep warpAmount at 0 to avoid folding.
float3 MapToEnvelopeSpace(float3 pWorld, float windStrength)
{
    float3 w = NormalizeXZ(_WindDir);
    float3 r = pWorld - _Center;
    r.y = 0.0;

    float along = dot(r, w);
    float3 perp = r - along * w;

    float a, b, sa, sp;
    GetLocalEnvelope(windStrength, along, a, b, sa, sp);

    float3 pEnv = _Center + (w * (along * sa) + perp * sp);
    pEnv.y = _Center.y;
    return pEnv;
}

// Binary-search the intersection with the envelope in WORLD space (q==1), independent of warpAmount.
float3 ClipToEnvelopeWorld(float3 p0World, float3 p1World, float windStrength)
{
    float t0 = 0.0, t1 = 1.0;
    [unroll] for (int k = 0; k < 12; k++)
    {
        float tm = 0.5 * (t0 + t1);
        float3 pm = lerp(p0World, p1World, tm);
        pm.y = _Center.y;

        float q = EnvelopeQ(pm, windStrength);
        if (q > 1.0) t1 = tm;
        else t0 = tm;
    }

    float3 hit = lerp(p0World, p1World, t1);
    hit.y = _Center.y;
    return hit;
}

float3 ApplyVisualOffsets(float3 p, float windStrength, float h)
{
    // Path warble in XZ
    if (_PathWarbleStrength > 1e-6)
    {
        float2 r2 = p.xz - _Center.xz;
        float r = length(r2);
        if (r > 1e-5)
        {
            float2 dir = r2 / r;
            float2 tan = float2(-dir.y, dir.x);

            float q = EnvelopeQ(p, windStrength);
            float damp = 1.0 - Smooth01(saturate((q - 0.70) / 0.30));

            float phase = _TimeNow * _PathWarbleSpeed + (r * _PathWarbleFrequency * 0.15) + h * 12.73;
            float wob = sin(phase) * _PathWarbleStrength * damp;

            p.xz += tan * wob;
            p = ClampToEnvelopePreserveY(p, windStrength);
        }
    }

    // Pseudo3D Y
    if (_Pseudo3DEnabled > 0.5 && _Pseudo3DAmplitude > 1e-6)
    {
        float2 r2 = p.xz - _Center.xz;
        float ang = atan2(r2.y, r2.x);
        float q = saturate(EnvelopeQ(p, windStrength));
        float w = Smoothstep01(0.15, 1.0, q);

        float phase = ang * _Pseudo3DTwist + _TimeNow * _Pseudo3DSpeed + h * 6.283;
        float yOff = sin(phase) * _Pseudo3DAmplitude * w;
        p.y = _Center.y + yOff;
    }
    else p.y = _Center.y;

    return p;
}

float3 WarpVisual(float3 pBase, float windStrength, float h)
{
    float3 p = WarpVisualNoClamp(pBase, windStrength);
    p.y = _Center.y;
    p = ClampToEnvelopePreserveY(p, windStrength);
    p = ApplyVisualOffsets(p, windStrength, h);
    return p;
}

float3 ClipToEnvelope(float3 p0Base, float3 p1Base, float windStrength)
{
    float t0 = 0.0, t1 = 1.0;
    [unroll] for (int k = 0; k < 10; k++)
    {
        float tm = 0.5*(t0 + t1);
        float3 pmBase = lerp(p0Base, p1Base, tm);
        float3 pmWarp = WarpVisualNoClamp(pmBase, windStrength);
        if (EnvelopeQ(pmWarp, windStrength) > 1.0) t1 = tm;
        else t0 = tm;
    }
    return lerp(p0Base, p1Base, t1);
}

float3 SnapToPlanetPole(float3 p)
{
    float3 r = p - _Center; r.y = 0.0;
    float rm = sqrt(max(0.0, dot(r,r)));
    float3 rDir = (rm > 1e-6) ? (r / rm) : float3(0,0,1);

    float3 axis = NormalizeXZ(_DipoleAxis);
    float s = (dot(rDir, axis) >= 0.0) ? 1.0 : -1.0;
    float3 poleDir = axis * s;

    float3 footDir = normalize(lerp(rDir, poleDir, 1.0));
    float3 outP = _Center + footDir * _PlanetRadius;
    outP.y = _Center.y;
    return outP;
}

float SolveEnvelopeRadiusAlongDir(float2 dir2, float windStrength)
{
    float3 dir = float3(dir2.x, 0.0, dir2.y);

    float low = 0.0;
    float high = _MagnetosphereRadius * 2.0;

    float qh;
    {
        float3 pH = _Center + dir * high; pH.y = _Center.y;
        qh = EnvelopeQ(pH, windStrength);
    }

    [unroll] for (int e = 0; e < 10; e++)
    {
        if (qh >= 1.0) break;
        high *= 1.5;
        float3 pH = _Center + dir * high; pH.y = _Center.y;
        qh = EnvelopeQ(pH, windStrength);
    }

    [unroll] for (int it = 0; it < 22; it++)
    {
        float mid = 0.5*(low + high);
        float3 pM = _Center + dir * mid; pM.y = _Center.y;
        float qm = EnvelopeQ(pM, windStrength);
        if (qm < 1.0) low = mid;
        else high = mid;
    }

    return high;
}

float3 MakeSeed(uint id, float windStrength)
{
    const float golden = 2.3999632297;
    float rot = (Hash01((uint)_RandomSeed) * 2.0 - 1.0) * 3.14159265;
    float ang = (float)id * golden + rot;

    float2 dir2 = normalize(float2(cos(ang), sin(ang)));
    float boundaryR = SolveEnvelopeRadiusAlongDir(dir2, windStrength);

    float inner = boundaryR * saturate(_SeedInnerFill);
    float outer = boundaryR * saturate(_SeedOuterFill);
    outer = max(outer, inner + 1e-3);

    float u = ((float)id + 0.5) / max(1.0, (float)_SeedCount);
    float rr = pow(saturate(u), max(0.25, _SeedRadialPower));
    float r = lerp(inner, outer, rr);

    float h = Hash01(id + 17u);
    float h2 = Hash01(id + 99u);

    float aj = (h2 - 0.5) * 2.0 * _SeedJitter * 0.35;
    float2 dirJ = Rot2(dir2, aj);
    float rJ = r * (1.0 + (h - 0.5) * 2.0 * _SeedJitter * 0.06);

    if (_SpinStrength > 1e-6)
    {
        float ringT = rr;
        float spinDir = (h < 0.5) ? -1.0 : 1.0;
        float a2 = _TimeNow * _SpinSpeed * (0.35 + 1.25*ringT) * _SpinStrength * spinDir;
        dirJ = Rot2(dirJ, a2);
    }

    float3 seed = _Center + float3(dirJ.x, 0.0, dirJ.y) * rJ;
    seed.y = _Center.y;
    return seed;
}

[numthreads(64,1,1)]
void IntegrateCS(uint3 tid : SV_DispatchThreadID)
{
    uint id = tid.x;
    if (id >= (uint)_SeedCount) return;

    float hLine = Hash01(id + 1u);

    // Seed selection (Metal requires _Seeds bound even if procedural)
    float3 seed = (_UseProceduralSeeds > 0.5) ? MakeSeed(id, _GlobalWindStrength) : _Seeds[id];
    seed.y = _Center.y;

    // Local storm influence at seed
    float frontCore, wake;
    StormMaskAt(seed, frontCore, wake);

    float localExtra = _StormIntensity * _StormWarpScale * _StormFrontLocalWarpAmount * frontCore * (1.0 - _StormGlobalWarpShare);
    float strength = _GlobalWindStrength + localExtra;

    // If seed is outside, shrink toward center
    float qSeed = EnvelopeQ(seed, strength);
    if (qSeed > 1.0)
    {
        float3 rr = seed - _Center; rr.y = 0.0;
        seed = _Center + rr / qSeed;
        seed.y = _Center.y;
    }

    // Trace both directions
    [unroll] for (int traceDirIdx = 0; traceDirIdx < 2; traceDirIdx++)
    {
        float dirSign = (traceDirIdx == 0) ? -1.0 : 1.0;
        float3 p = seed;

        for (int s = 0; s < _MaxSteps; s++)
        {
            // Planet snap
            float3 rp = p - _Center; rp.y = 0.0;
            float r2 = dot(rp, rp);
            if (r2 <= (_PlanetRadius * _PlanetRadius) * 1.3)
            {
                float3 foot = SnapToPlanetPole(p);
                Segment segF;
                segF.a = WarpVisual(p, strength, hLine);
                segF.b = WarpVisual(foot, strength, hLine);
                segF.mag = 1.0;
                _Segments.Append(segF);
                break;
            }

            // Base dipole field
            float3 B = DipoleField(p);
            float mag = length(B);
            if (mag < _MinMag) break;

            float3 baseDir = NormalizeXZ(B) * dirSign;

            // Envelope metric in WORLD space
            float q0 = EnvelopeQ(p, strength);

            // Boundary drape (late) – only near q->1
            float ease = Smoothstep01(_BoundaryEaseStart, 1.0, q0);
            ease = pow(max(1e-6, ease), max(0.25, _BoundaryEasePower));

            // Global conformity (early) – leans arcs with envelope BEFORE boundary
            float conformW = Smoothstep01(_ConformStartQ, 1.0, q0);
            conformW = pow(max(1e-6, conformW), max(0.25, _ConformExp)) * saturate(_ConformAmount);

            // Step damping near boundary
            float ds = _Step * lerp(1.0, 0.35, ease);

            // Compute envelope-space direction for conformity (independent of warpAmount)
            float3 pEnv = MapToEnvelopeSpace(p, strength);

            float3 nextCand0 = p + baseDir * ds; nextCand0.y = _Center.y;
            float3 nextEnv0 = MapToEnvelopeSpace(nextCand0, strength);
            float3 envDir0 = NormalizeXZ(nextEnv0 - pEnv);

            // Lean base direction toward envelope-space direction
            float3 leanDir = NormalizeXZ(lerp(baseDir, envDir0, conformW));

            // Re-evaluate envelope-space direction using leanDir for stability
            float3 nextCand1 = p + leanDir * ds; nextCand1.y = _Center.y;
            float3 nextEnv1 = MapToEnvelopeSpace(nextCand1, strength);
            float3 envDir = NormalizeXZ(nextEnv1 - pEnv);

            // Boundary tangent (WORLD normal)
            float3 n = EnvelopeNormalApprox(p, strength);
            float3 tanDir = envDir - n * dot(envDir, n);
            tanDir = NormalizeXZ(tanDir);
            if (dot(tanDir, tanDir) < 1e-8) tanDir = envDir;

            // Final move direction: conform early, drape late
            float3 moveDir = NormalizeXZ(lerp(leanDir, tanDir, ease));
            if (dot(moveDir, moveDir) < 1e-8) moveDir = baseDir;

            float3 next = p + moveDir * ds;
            next.y = _Center.y;

            float q1 = EnvelopeQ(next, strength);

            // Visual endpoints (color/warble/pseudo3D happen inside WarpVisual)
            float3 aW = WarpVisual(p, strength, hLine);

            // Boundary crossing: clip, append, then continue along boundary
            if (q0 <= 1.0 && q1 > 1.0)
            {
                float3 hitBase = ClipToEnvelopeWorld(p, next, strength);
                float3 bW = WarpVisual(hitBase, strength, hLine);

                Segment segC;
                segC.a = aW;
                segC.b = bW;
                segC.mag = mag;
                _Segments.Append(segC);

                // Continue from just inside boundary
                float3 nHit = EnvelopeNormalApprox(hitBase, strength);
                float eps = max(0.001, 0.002 * _MagnetosphereRadius);

                float3 pNext = hitBase - nHit * eps;
                pNext.y = _Center.y;
                p = ClampToEnvelopePreserveY(pNext, strength);
                p.y = _Center.y;
                continue;
            }

            if (q0 > 1.0) break;

            float3 bW2 = WarpVisual(next, strength, hLine);

            Segment seg;
            seg.a = aW;
            seg.b = bW2;
            seg.mag = mag;
            _Segments.Append(seg);

            p = next;
        }
    }
}